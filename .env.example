# Direct Neon PostgreSQL connection string used for local development and migrations.
DATABASE_URL="postgres://user:password@ep-example.neon.tech/kelsier?sslmode=require"

# Optional pooled PostgreSQL URL, such as Cloudflare Hyperdrive or PgBouncer.
DATABASE_URL_POOLED="postgres://user:password@pooled.example/kelsier?sslmode=require"

# Set to true to use DATABASE_URL_POOLED instead of DATABASE_URL.
USE_HYPERDRIVE="false"

# Cloudflare R2 bucket name for files, exports, and AI report objects.
R2_BUCKET_NAME="kelsier-dev"

# Cloudflare account ID that owns the R2 bucket.
R2_ACCOUNT_ID="replace-with-account-id"

# R2 access key ID for server-side object operations.
R2_ACCESS_KEY_ID="replace-with-access-key-id"

# R2 secret access key for server-side object operations.
R2_SECRET_ACCESS_KEY="replace-with-secret-access-key"

{
	"name": "project-kelsier",
	"version": "0.3.4",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
	"engines": {
		"node": "24.x"
	},
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"preview": "pnpm build && vite preview",
		"deploy": "pnpm build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --config vitest.config.ts",
		"coverage": "vitest run --config vitest.config.ts --coverage",
		"test:e2e": "playwright test",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:seed": "tsx scripts/seed.ts",
		"version:show": "node -p \"require('./package.json').version\"",
		"version:check": "node scripts/check-version-metadata.mjs",
		"ci": "pnpm check && pnpm typecheck && pnpm test && pnpm build && pnpm build-storybook"
	},
	"dependencies": {
		"@neondatabase/serverless": "^1.1.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-devtools": "0.10.10",
		"@tanstack/react-router": "1.170.29",
		"@tanstack/react-router-devtools": "1.167.1",
		"@tanstack/react-router-ssr-query": "1.167.1",
		"@tanstack/react-start": "1.168.46",
		"@tanstack/router-plugin": "1.168.32",
		"drizzle-orm": "^0.45.2",
		"lucide-react": "^1.32.0",
		"postgres": "^3.4.9",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.9",
		"@cloudflare/vite-plugin": "^1.53.0",
		"@playwright/test": "^1.62.1",
		"@storybook/addon-a11y": "10.5.9",
		"@storybook/react-vite": "10.5.9",
		"@tailwindcss/typography": "^0.5.20",
		"@tanstack/devtools-vite": "0.8.3",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.5",
		"@vitest/coverage-v8": "^4.1.10",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"jsdom": "^30.0.1",
		"storybook": "10.5.9",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2",
		"vite": "^8.2.1",
		"vitest": "^4.1.10",
		"wrangler": "^4.124.0"
	}
}

{
	"name": "project-kelsier",
	"version": "0.4.6",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
	"engines": {
		"node": ">=26.11.1 <27.0.0"
	},
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "node scripts/prepare-dev.mjs && vite dev --port 3000",
		"dev:app": "vite dev --port 3000",
		"build": "vite build",
		"preview": "pnpm build && vite preview",
		"deploy": "pnpm build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"worker:check": "wrangler deploy --dry-run",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --config vitest.config.ts",
		"coverage": "vitest run --config vitest.config.ts --coverage",
		"test:e2e": "playwright test",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:seed": "tsx scripts/seed.ts",
		"version:show": "node -p \"require('./package.json').version\"",
		"version:check": "node scripts/check-version-metadata.mjs",
		"ci": "pnpm check && pnpm typecheck && pnpm test && pnpm build"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-devtools": "0.10.13",
		"@tanstack/react-router": "1.170.44",
		"@tanstack/react-router-devtools": "1.167.2",
		"@tanstack/react-router-ssr-query": "1.167.3",
		"@tanstack/react-start": "1.169.2",
		"@tanstack/router-plugin": "1.168.46",
		"drizzle-orm": "^0.45.4",
		"lucide-react": "^1.57.0",
		"postgres": "^3.4.9",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@cloudflare/vite-plugin": "^1.60.2",
		"@playwright/test": "^1.64.1",
		"@tanstack/devtools-vite": "0.8.5",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"@vitest/coverage-v8": "^4.1.11",
		"dotenv": "^18.0.8",
		"drizzle-kit": "^0.31.11",
		"jsdom": "^30.1.3",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"vitest": "^4.1.11",
		"wrangler": "^4.141.0"
	}
}

{
	"name": "project-kelsier",
	"version": "0.2.6",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882",
	"engines": {
		"node": "24.x"
	},
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"preview": "pnpm build && vite preview",
		"deploy": "pnpm build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --config vitest.config.ts",
		"coverage": "vitest run --config vitest.config.ts --coverage",
		"test:e2e": "playwright test",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:seed": "tsx scripts/seed.ts",
		"version:show": "node -p \"require('./package.json').version\"",
		"version:check": "node scripts/check-version-metadata.mjs",
		"ci": "pnpm check && pnpm typecheck && pnpm test && pnpm build && pnpm build-storybook"
	},
	"dependencies": {
		"@neondatabase/serverless": "^1.1.0",
		"@tailwindcss/vite": "^4.3.2",
		"@tanstack/react-devtools": "0.10.8",
		"@tanstack/react-router": "1.170.17",
		"@tanstack/react-router-devtools": "1.167.0",
		"@tanstack/react-router-ssr-query": "1.167.1",
		"@tanstack/react-start": "1.168.27",
		"@tanstack/router-plugin": "1.168.19",
		"drizzle-orm": "^0.45.2",
		"lucide-react": "^1.24.0",
		"postgres": "^3.4.9",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"tailwindcss": "^4.3.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.3",
		"@cloudflare/vite-plugin": "^1.44.0",
		"@playwright/test": "^1.61.1",
		"@storybook/addon-a11y": "10.5.0",
		"@storybook/react-vite": "10.5.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tanstack/devtools-vite": "0.8.1",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"@vitest/coverage-v8": "^4.1.10",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"jsdom": "^29.1.1",
		"storybook": "10.5.0",
		"tsx": "^4.23.0",
		"typescript": "^7.0.2",
		"vite": "^8.1.4",
		"vitest": "^4.1.10",
		"wrangler": "^4.110.0"
	}
}

{
	"name": "project-kelsier",
	"version": "0.4.11",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
	"engines": {
		"node": ">=26.13.1 <27.0.0"
	},
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "node scripts/prepare-dev.mjs && vite dev --port 3000",
		"dev:app": "vite dev --port 3000",
		"build": "vite build",
		"preview": "pnpm build && vite preview",
		"deploy": "pnpm build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"worker:check": "wrangler deploy --dry-run",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --config vitest.config.ts",
		"coverage": "vitest run --config vitest.config.ts --coverage",
		"test:e2e": "playwright test",
		"test:transport": "playwright test --config playwright.transport.config.ts",
		"test:worker-body": "node scripts/check-worker-body-rejection.mjs",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:seed": "tsx scripts/seed.ts",
		"version:show": "node -p \"require('./package.json').version\"",
		"version:check": "node scripts/check-version-metadata.mjs",
		"ci": "pnpm check && pnpm typecheck && pnpm test && pnpm build"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.5",
		"@tanstack/react-devtools": "0.10.14",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-router-devtools": "1.167.3",
		"@tanstack/react-router-ssr-query": "1.167.3",
		"@tanstack/react-start": "1.169.5",
		"@tanstack/router-plugin": "1.169.0",
		"drizzle-orm": "^0.45.4",
		"lucide-react": "^1.73.0",
		"postgres": "^4.1.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwindcss": "^4.3.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@cloudflare/vite-plugin": "^1.69.1",
		"@playwright/test": "^1.65.1",
		"@tanstack/devtools-vite": "0.8.6",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"@vitest/coverage-v8": "^4.1.12",
		"dotenv": "^18.0.10",
		"drizzle-kit": "^0.31.11",
		"jsdom": "^31.0.1",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^4.1.12",
		"wrangler": "^4.162.0"
	}
}

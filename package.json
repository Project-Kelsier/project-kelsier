{
	"name": "project-kelsier",
	"version": "0.2.2",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.5.3+sha512.7ac1c919341c213a34dc0d02afb7143c5c26ac26ee8c4782deea821b8ac64d2134a081fd8941dae6e29bbb48f58dfc2b7fbceeccc07cb2f09d219d342a4969ed",
	"engines": {
		"node": "24.x"
	},
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"preview": "pnpm build && vite preview",
		"deploy": "pnpm build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --config vitest.config.ts",
		"coverage": "vitest run --config vitest.config.ts --coverage",
		"test:e2e": "playwright test",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:seed": "tsx scripts/seed.ts",
		"version:show": "node -p \"require('./package.json').version\"",
		"version:check": "node scripts/check-version-metadata.mjs",
		"ci": "pnpm check && pnpm typecheck && pnpm test && pnpm build"
	},
	"dependencies": {
		"@neondatabase/serverless": "^1.1.0",
		"@tailwindcss/vite": "^4.3.1",
		"@tanstack/react-devtools": "0.10.8",
		"@tanstack/react-router": "1.170.16",
		"@tanstack/react-router-devtools": "1.167.0",
		"@tanstack/react-router-ssr-query": "1.167.1",
		"@tanstack/react-start": "1.168.26",
		"@tanstack/router-plugin": "1.168.18",
		"drizzle-orm": "^0.45.2",
		"lucide-react": "^1.21.0",
		"postgres": "^3.4.9",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"tailwindcss": "^4.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.1",
		"@cloudflare/vite-plugin": "^1.42.3",
		"@playwright/test": "^1.61.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tanstack/devtools-vite": "0.8.1",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^24.13.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"@vitest/coverage-v8": "^4.1.9",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"jsdom": "^29.1.1",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"vite": "^8.1.0",
		"vitest": "^4.1.9",
		"wrangler": "^4.105.0"
	}
}

{
	"name": "project-kelsier",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499",
	"engines": {
		"node": "24.x"
	},
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"preview": "pnpm build && vite preview",
		"deploy": "pnpm build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --config vitest.config.ts",
		"coverage": "vitest run --config vitest.config.ts --coverage",
		"test:e2e": "playwright test",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:seed": "tsx scripts/seed.ts",
		"version:show": "node -p \"require('./package.json').version\"",
		"version:check": "node scripts/check-version-metadata.mjs",
		"ci": "pnpm check && pnpm typecheck && pnpm test && pnpm build"
	},
	"dependencies": {
		"@neondatabase/serverless": "^1.1.0",
		"@tailwindcss/vite": "^4.2.4",
		"@tanstack/react-devtools": "0.10.5",
		"@tanstack/react-router": "1.170.3",
		"@tanstack/react-router-devtools": "1.167.0",
		"@tanstack/react-router-ssr-query": "1.167.0",
		"@tanstack/react-start": "1.168.5",
		"@tanstack/router-plugin": "1.168.5",
		"drizzle-orm": "^0.45.2",
		"lucide-react": "^1.14.0",
		"postgres": "^3.4.9",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"tailwindcss": "^4.2.4"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.14",
		"@cloudflare/vite-plugin": "^1.36.0",
		"@playwright/test": "^1.59.1",
		"@tailwindcss/typography": "^0.5.19",
		"@tanstack/devtools-vite": "0.7.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^24.12.2",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"@vitest/coverage-v8": "^4.1.5",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"jsdom": "^29.1.1",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.11",
		"vitest": "^4.1.5",
		"wrangler": "^4.88.0"
	}
}

{
	"name": "project-kelsier",
	"version": "0.4.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
	"engines": {
		"node": "24.x"
	},
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "node scripts/prepare-dev.mjs && vite dev --port 3000",
		"dev:app": "vite dev --port 3000",
		"build": "vite build",
		"preview": "pnpm build && vite preview",
		"deploy": "pnpm build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"worker:check": "wrangler deploy --dry-run",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --config vitest.config.ts",
		"coverage": "vitest run --config vitest.config.ts --coverage",
		"test:e2e": "playwright test",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:seed": "tsx scripts/seed.ts",
		"version:show": "node -p \"require('./package.json').version\"",
		"version:check": "node scripts/check-version-metadata.mjs",
		"ci": "pnpm check && pnpm typecheck && pnpm test && pnpm build && pnpm build-storybook"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-devtools": "0.10.10",
		"@tanstack/react-router": "1.170.29",
		"@tanstack/react-router-devtools": "1.167.1",
		"@tanstack/react-router-ssr-query": "1.167.1",
		"@tanstack/react-start": "1.168.46",
		"@tanstack/router-plugin": "1.168.32",
		"drizzle-orm": "^0.45.2",
		"lucide-react": "^1.32.0",
		"postgres": "^3.4.9",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@cloudflare/vite-plugin": "^1.54.7",
		"@playwright/test": "^1.62.1",
		"@storybook/addon-a11y": "10.5.9",
		"@storybook/react-vite": "10.5.9",
		"@tailwindcss/typography": "^0.5.20",
		"@tanstack/devtools-vite": "0.8.3",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^24.13.4",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.1.1",
		"@vitest/coverage-v8": "^4.1.11",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"jsdom": "^30.0.1",
		"storybook": "10.5.9",
		"tsx": "^4.23.13",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "^4.1.11",
		"wrangler": "^4.131.0"
	}
}

{
	"name": "project-kelsier",
	"version": "0.4.2",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
	"engines": {
		"node": ">=24.15.0 <25.0.0"
	},
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "node scripts/prepare-dev.mjs && vite dev --port 3000",
		"dev:app": "vite dev --port 3000",
		"build": "vite build",
		"preview": "pnpm build && vite preview",
		"deploy": "pnpm build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"worker:check": "wrangler deploy --dry-run",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --config vitest.config.ts",
		"coverage": "vitest run --config vitest.config.ts --coverage",
		"test:e2e": "playwright test",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:seed": "tsx scripts/seed.ts",
		"version:show": "node -p \"require('./package.json').version\"",
		"version:check": "node scripts/check-version-metadata.mjs",
		"ci": "pnpm check && pnpm typecheck && pnpm test && pnpm build && pnpm build-storybook"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-devtools": "0.10.13",
		"@tanstack/react-router": "1.170.39",
		"@tanstack/react-router-devtools": "1.167.2",
		"@tanstack/react-router-ssr-query": "1.167.3",
		"@tanstack/react-start": "1.168.58",
		"@tanstack/router-plugin": "1.168.40",
		"drizzle-orm": "^0.45.3",
		"lucide-react": "^1.48.0",
		"postgres": "^3.4.9",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@cloudflare/vite-plugin": "^1.60.2",
		"@playwright/test": "^1.63.0",
		"@storybook/addon-a11y": "10.6.0",
		"@storybook/react-vite": "10.6.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tanstack/devtools-vite": "0.8.5",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^24.19.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"@vitest/coverage-v8": "^4.1.11",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.11",
		"jsdom": "^30.1.1",
		"storybook": "10.6.0",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "^8.3.1",
		"vitest": "^4.1.11",
		"wrangler": "^4.141.0"
	}
}

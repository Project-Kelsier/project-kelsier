{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "project-kelsier",
	"compatibility_date": "2026-08-06",
	"compatibility_flags": ["nodejs_compat"],
	"main": "src/worker.ts",
	"assets": {
		"directory": "./dist/client"
	},
	"observability": {
		"enabled": true,
		"logs": {
			"head_sampling_rate": 1
		}
	},
	"triggers": {
		"crons": ["17 3 * * *"]
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "280a2e296ce34b2796b63a6ed11f568a",
			"localConnectionString": "postgres://kelsier:kelsier@localhost:55432/kelsier_dev"
		}
	],
	"ratelimits": [
		{
			"name": "ASSESSMENT_ATTEMPT_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 10,
				"period": 60
			}
		}
	]
}

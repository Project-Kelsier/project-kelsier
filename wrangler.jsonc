{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "project-kelsier",
	"compatibility_date": "2026-04-10",
	"compatibility_flags": ["nodejs_compat"],
	"main": "@tanstack/react-start/server-entry",
	"assets": {
		"directory": "./dist/client"
	},
	"observability": {
		"enabled": true
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "280a2e296ce34b2796b63a6ed11f568a",
			"localConnectionString": "postgres://kelsier:kelsier@localhost:55432/kelsier_dev"
		}
	]
}
